<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Fragment content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/background"
        android:elevation="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="@color/bottom_nav_color"
                android:contentDescription="@string/home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/home"
                android:textColor="@color/bottom_nav_color"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />

        </LinearLayout>

        <!-- Calendar -->
        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/bottom_nav_color"
                android:contentDescription="@string/calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/calendar"
                android:textColor="@color/bottom_nav_color"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />

        </LinearLayout>

        <!-- Center space -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Tasks  -->
        <LinearLayout
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_task"
                app:tint="@color/bottom_nav_color"
                android:contentDescription="@string/tasks" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tasks"
                android:textColor="@color/bottom_nav_color"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/bottom_nav_color"
                android:contentDescription="@string/profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/profile"
                android:textColor="@color/bottom_nav_color"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />

        </LinearLayout>

    </LinearLayout>


    <!-- Center Add Task button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/add_task"
        android:src="@drawable/ic_add"
        app:fabSize="normal"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white"
        app:maxImageSize="26dp"
        app:shapeAppearanceOverlay="@style/CircularFab"
        app:elevation="6dp"
        app:layout_constraintTop_toTopOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-12dp" />

    <!-- Add Task label -->
    <TextView
        android:id="@+id/txtAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_task"
        android:textColor="@color/primary_text"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:elevation="7dp"
        app:layout_constraintBottom_toBottomOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="@id/fabAddTask"
        app:layout_constraintEnd_toEndOf="@id/fabAddTask"
        android:layout_marginBottom="3dp" />


    <!-- Floating StudyMate button -->
    <ImageButton
        android:id="@+id/btnStudyMate"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_studymate_send"
        android:src="@drawable/ic_studymate"
        android:scaleType="centerInside"
        android:contentDescription="Open StudyMate"
        android:padding="12dp"
        android:elevation="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp" />

    <!-- StudyMate response preview -->
    <TextView
        android:id="@+id/studyMateResponseBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="StudyMate has responded"
        android:textColor="@color/primary_text"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"
        android:background="@drawable/bg_studymate_response_bubble"
        android:elevation="18dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/btnStudyMate"
        app:layout_constraintBottom_toTopOf="@id/btnStudyMate"
        android:layout_marginBottom="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>