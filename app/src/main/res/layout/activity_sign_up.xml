<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Image Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/study_logo"
        android:contentDescription="@string/splash_logo_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"/>

    <!-- Create Account Text -->
    <TextView
        android:id="@+id/txtCreateAccount"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/create_account"

        android:fontFamily="@font/poppins_bold"
        android:textSize="30sp"
        android:textColor="#0D2B5B"

        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="20dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSignupSubtitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/signup_subtitle"

        android:fontFamily="@font/poppins_regular"
        android:textSize="16sp"
        android:textColor="#555555"
        android:textStyle="italic"

        app:layout_constraintTop_toBottomOf="@id/txtCreateAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="8dp"/>

    <!-- Enter Full Name-->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameInputLayout"

        android:layout_width="300dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="32dp"

        app:layout_constraintTop_toBottomOf="@id/txtSignupSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:boxBackgroundMode="outline"

        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">


        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/edtFullName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_regular"

            android:textSize="14sp"

            android:textColor="#0D2B5B"
            android:textColorHint="#0D2B5B"

            android:hint="@string/enter_full_name"

            android:inputType="textPersonName"

            android:padding="12dp"/>


    </com.google.android.material.textfield.TextInputLayout>

    <!-- Enter Email -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emailInputLayout"

        android:layout_width="300dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/nameInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:boxBackgroundMode="outline"

        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">


        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/edtEmail"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_regular"

            android:textSize="14sp"

            android:textColor="#0D2B5B"
            android:textColorHint="#0D2B5B"

            android:hint="@string/enter_email"

            android:inputType="textEmailAddress"

            android:autofillHints="emailAddress"

            android:padding="12dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password box  -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordInputLayout"

        android:layout_width="300dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/emailInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:boxBackgroundMode="outline"

        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"

        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/edtPassword"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_regular"

            android:textSize="14sp"

            android:textColor="#0D2B5B"
            android:textColorHint="#0D2B5B"

            android:hint="@string/enter_password"

            android:inputType="textPassword"

            android:autofillHints="password"

            android:padding="12dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/confirmPasswordInputLayout"

        android:layout_width="300dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        app:layout_constraintTop_toBottomOf="@id/passwordInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:boxBackgroundMode="outline"

        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"

        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/edtConfirmPassword"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_regular"

            android:textSize="14sp"

            android:textColor="#0D2B5B"
            android:textColorHint="#0D2B5B"

            android:hint="@string/confirm_password"

            android:inputType="textPassword"

            android:autofillHints="password"

            android:padding="12dp"/>
    </com.google.android.material.textfield.TextInputLayout>

        <!-- Sign up button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignup"

            android:layout_width="300dp"
            android:layout_height="55dp"

            android:layout_marginTop="28dp"

            android:text="@string/sign_up"

            android:textAllCaps="false"

            android:textColor="#FFFFFF"
            android:textSize="16sp"

            android:fontFamily="@font/poppins_semibold"

            app:backgroundTint="#1E88E5"

            app:cornerRadius="12dp"

            app:layout_constraintTop_toBottomOf="@id/confirmPasswordInputLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Already have an account? Login-->
    <LinearLayout
        android:id="@+id/loginLayout"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:layout_marginTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/btnSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- Already have an account?-->
        <TextView
            android:id="@+id/txtAlreadyHaveAccount"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/already_have_account"

            android:fontFamily="@font/poppins_regular"

            android:textSize="15sp"

            android:textColor="#555555"/>
        <!-- Login-->
        <TextView
            android:id="@+id/txtLogin"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="5dp"

            android:minHeight="48dp"
            android:minWidth="48dp"

            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"

            android:text="@string/login"

            android:fontFamily="@font/poppins_semibold"

            android:textSize="15sp"

            android:textColor="#1E88E5"

            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

