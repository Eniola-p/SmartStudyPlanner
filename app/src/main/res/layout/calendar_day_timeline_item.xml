<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:orientation="horizontal">

    <!-- Hour shown on the left -->
    <TextView
        android:id="@+id/txtTimelineTime"
        android:layout_width="58dp"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:paddingTop="8dp"
        android:text="8 AM"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Timeline line and dot -->
    <FrameLayout
        android:layout_width="16dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/viewTimelineLine"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@color/divider"/>

        <View
            android:id="@+id/viewTimelineDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_calendar_indicator"/>
    </FrameLayout>

    <!-- Multiple task cards can be placed here -->
    <LinearLayout
        android:id="@+id/timelineTaskContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingBottom="8dp">

        <!-- Individual task cards will be added here -->

    </LinearLayout>

</LinearLayout>