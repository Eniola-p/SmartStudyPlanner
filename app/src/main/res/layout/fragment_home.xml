<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background">

    <!-- Allows the dashboard to scroll when content becomes longer than the screen. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDashboard"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Holds every dashboard section vertically. -->
        <LinearLayout
            android:id="@+id/layoutDashboard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">

            <!-- Greeting Section -->

            <TextView
                android:id="@+id/txtGreeting"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@string/placeholder_greeting"
                android:textColor="@color/primary_text"
                android:textSize="28sp"

                android:fontFamily="@font/poppins_bold"/>

            <TextView
                android:id="@+id/txtCurrentDate"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="@string/placeholder_date"

                android:textColor="@color/secondary_text"
                android:textSize="16sp"

                android:fontFamily="@font/poppins_regular"/>

            <!-- Today's Study Tasks Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayTasks"
                style="@style/Widget.SmartStudyPlanner.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtTodayTasksTitle"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/today_study_tasks"

                        android:textColor="@color/primary_text"
                        android:textSize="18sp"

                        android:fontFamily="@font/poppins_semibold"/>

                    <TextView
                        android:id="@+id/txtTaskOne"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="18dp"

                        android:text="@string/placeholder_task_one"

                        android:textColor="@color/secondary_text"
                        android:textSize="15sp"

                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/txtTaskTwo"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="@string/placeholder_task_two"

                        android:textColor="@color/secondary_text"
                        android:textSize="15sp"

                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/txtTaskThree"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="@string/placeholder_task_three"

                        android:textColor="@color/secondary_text"
                        android:textSize="15sp"

                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/txtViewAllTasks"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="18dp"

                        android:text="@string/view_all_tasks"

                        android:textColor="@color/primary"
                        android:textSize="14sp"

                        android:fontFamily="@font/poppins_medium"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- ========================================================= -->
            <!-- Upcoming Deadlines Card -->
            <!-- ========================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpcomingDeadlines"
                style="@style/Widget.SmartStudyPlanner.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Card Title -->
                    <TextView
                        android:id="@+id/txtUpcomingDeadlinesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upcoming_deadlines"
                        android:textColor="@color/primary_text"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <!-- Deadline One -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDeadlineOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_deadline_one"
                            android:textColor="@color/primary_text"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:id="@+id/txtDeadlineDateOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/placeholder_deadline_date_one"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular" />

                    </LinearLayout>

                    <!-- Divider -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/divider" />

                    <!-- Deadline Two -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDeadlineTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_deadline_two"
                            android:textColor="@color/primary_text"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:id="@+id/txtDeadlineDateTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/placeholder_deadline_date_two"
                            android:textColor="@color/accent"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular" />

                    </LinearLayout>

                    <!-- View All -->
                    <TextView
                        android:id="@+id/txtViewAllDeadlines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/view_all_deadlines"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================================= -->
            <!-- Study Progress Card -->
            <!-- ========================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudyProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <!-- Card Title -->
                    <TextView
                        android:id="@+id/txtStudyProgressTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/study_progress"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/text_heading"
                        android:fontFamily="@font/poppins_semibold" />

                    <!-- Weekly Goal + Percentage -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtWeeklyGoal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/weekly_goal"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/txtProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_progress"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressStudy"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:max="100"
                        android:progress="40"
                        android:progressDrawable="@drawable/progress_bar" />

                    <!-- Progress Summary -->
                    <TextView
                        android:id="@+id/txtProgressSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/progress_summary"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/text_small"
                        android:fontFamily="@font/poppins_regular" />

                    <!-- View Statistics -->
                    <TextView
                        android:id="@+id/txtViewStatistics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:text="@string/view_statistics"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_small"
                        android:fontFamily="@font/poppins_medium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>