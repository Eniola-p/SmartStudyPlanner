<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Profile header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Page title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- Settings icon -->
            <ImageView
                android:id="@+id/imgProfileSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Profile section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/profile_card_background"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Profile picture with camera button -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <!-- Circular profile picture -->
                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile_picture"
                        android:background="@drawable/bg_profile_circle" />

                    <!-- Small camera button -->
                    <ImageButton
                        android:id="@+id/btnChangeProfilePicture"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:padding="7dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="Change profile picture"
                        android:clickable="true"
                        android:focusable="true" />

                </FrameLayout>

                <!-- Student name -->
                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/primary_text"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_bold" />

                <!-- Email -->
                <TextView
                    android:id="@+id/txtProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Edit profile button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/edit_profile"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:backgroundTint="@color/primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Academic Information section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/profile_card_background"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Academic information title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/academic_information"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold" />

                <!-- Department -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Department / Programme"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/txtProfileDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not set"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Level -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Level"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/txtProfileLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not set"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/divider" />

                <!-- Study preferences -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Study Preferences"
                    android:textColor="@color/primary_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_semibold" />

                <!-- Preferred study time -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Preferred Study Time"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/txtPreferredStudyTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not set"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Available study hours -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Available Study Hours"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/txtAvailableStudyHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Not set"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/divider" />

                <!-- Study statistics -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Study Statistics"
                    android:textColor="@color/primary_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_semibold" />

                <!-- Completed tasks -->
                <TextView
                    android:id="@+id/txtCompletedTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Completed Tasks: 0"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Pending tasks -->
                <TextView
                    android:id="@+id/txtPendingTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pending Tasks: 0"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

                <!-- Missed tasks -->
                <TextView
                    android:id="@+id/txtMissedTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Missed Tasks: 0"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_regular" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>