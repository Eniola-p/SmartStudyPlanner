<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgBackTaskDetails"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/task_details"
            android:textColor="@color/primary_text"
            android:textSize="24sp"
            android:fontFamily="@font/poppins_bold" />

        <!-- Edit -->
        <ImageView
            android:id="@+id/imgEditTask"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/edit_task"
            android:clickable="true"
            android:focusable="true" />

        <!-- Delete -->
        <ImageView
            android:id="@+id/imgDeleteTask"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete_task"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Task information -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/txtDetailsTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_bold" />

            <!-- Course -->
            <TextView
                android:id="@+id/txtDetailsTaskCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/txtDetailsTaskDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_regular" />

            <!-- Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/time"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/txtDetailsTaskTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_regular" />

            <!-- Priority -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/priority"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/txtDetailsTaskPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_dark"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/status"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/txtDetailsTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/description"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/txtDetailsTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_regular" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>